# Stripe Publishable Key (for frontend payment processing)
# Get your key from: https://dashboard.stripe.com/test/apikeys
# This should start with pk_test_ for test mode
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# Google Maps API Key (for maps and Places autocomplete)
# Get your key from: https://console.cloud.google.com/
# Enable: Maps SDK for iOS, Maps SDK for Android, Places API, Geocoding API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""

# API Base URL (optional, defaults to localhost in development)
# EXPO_PUBLIC_API_URL="http://localhost:3001/api"

# Public web origin used for canonical URLs, sitemap generation, and OpenGraph defaults
# EXPO_PUBLIC_WEB_URL="https://buildmyhouse.app"

# Google Search Console domain verification token
# EXPO_PUBLIC_GSC_VERIFICATION=""

# GA4 Measurement ID for web analytics (format: G-XXXXXXXXXX)
# EXPO_PUBLIC_GA_MEASUREMENT_ID=""

# Reddit Ads pixel ID for web conversion tracking (format: a2_xxxxxxxxxx)
# EXPO_PUBLIC_REDDIT_PIXEL_ID=""

# Google Sign-In — **Web application** OAuth client ID (same as backend GOOGLE_CLIENT_ID for code exchange)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Optional web-only: EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
# Optional exact redirect: EXPO_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI=

# Price Checker — auto-open completed report in a new tab (default false; user must click Open report)
# EXPO_PUBLIC_PRICE_CHECKER_AUTO_OPEN_REPORT=false

# Price Checker Stage 7 — guest Paystack checkout
# Backend must set Paystack callback to:
#   ${EXPO_PUBLIC_WEB_URL}/tools/price-checker/payment/callback
# No Paystack secret or public key belongs in the mobile-homeowner bundle.
# EXPO_PUBLIC_WEB_URL is already used for canonical URLs (see above).

# Trustindex review widget id (the part after "loader.js?" in the Trustindex embed code).
# One widget showing Google reviews only. Leave empty to hide the widget.
# EXPO_PUBLIC_TRUSTINDEX_WIDGET_ID
# Optional: separate widget styled for the contractor site. Falls back to EXPO_PUBLIC_TRUSTINDEX_WIDGET_ID.
# EXPO_PUBLIC_TRUSTINDEX_GC_WIDGET_ID
# Trustpilot Review Collector business unit id. Leave empty to use a plain review link.
# Set the same names as production build env (GitHub Actions secrets) before the widget can show live.
# EXPO_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID
