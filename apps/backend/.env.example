# Database
DATABASE_URL="postgresql://user:password@localhost:5432/buildmyhouse?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Stripe Payment Processing
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# OpenAI API (for plan analysis)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your_openai_api_key_here"
# Optional: model override (defaults to gpt-4o)
OPENAI_MODEL="gpt-4o"

# Price Checker — Stage 4 AI-first live research (docs/price-checker/STAGE4_IMPLEMENTATION_PLAN.md)
# All optional; defaults shown. Only 'openai_web_search' / 'direct_public' are implemented;
# external providers are benchmark-gated (docs/price-checker/PROVIDER_DECISION_RECORD.md).
PRICE_CHECKER_MATRIX_MODEL="gpt-5.6-sol"
# PRICE_CHECKER_EXTRACTION_MODEL="gpt-5.6-sol"
# PRICE_CHECKER_PLANNING_MODEL="gpt-5.6-sol"
# PRICE_CHECKER_SEARCH_PROVIDER="openai_web_search"
# PRICE_CHECKER_PAGE_RETRIEVER="direct_public"
# PRICE_CHECKER_BROWSER_FALLBACK_ENABLED="false"
# PRICE_CHECKER_MAX_SEARCH_QUERIES="6"
# PRICE_CHECKER_MAX_SOURCES_PER_ITEM="12"
# PRICE_CHECKER_RESEARCH_TIMEOUT_MS="120000"
# PRICE_CHECKER_SOURCE_CACHE_TTL_HOURS="72"
# When true, always run live web research even if merchant/admin observations already form a range
# PRICE_CHECKER_FORCE_LIVE_RESEARCH="false"
# PRICE_CHECKER_MAX_PAGE_BYTES="3000000"
# PRICE_CHECKER_PAGE_FETCH_TIMEOUT_MS="15000"
# PRICE_CHECKER_PAGE_FETCH_MAX_RETRIES="2"
# PRICE_CHECKER_USER_AGENT="BuildMyHousePriceChecker/1.0 (+https://buildmyhouse.app/price-checker; research bot; contact: support@buildmyhouse.app)"
# USD per 1M tokens per model, e.g. {"gpt-5.6-sol":{"inputPerM":2,"outputPerM":8,"cachedInputPerM":1}}
# Without this, research cost is reported in tokens only (never a fabricated dollar figure).
# PRICE_CHECKER_MODEL_PRICING_JSON=""

# Stage 6 — consumer Price Checker (free tier + report access)
# PRICE_CHECKER_ANONYMOUS_DAILY_LIMIT="2"
# PRICE_CHECKER_AUTHENTICATED_DAILY_LIMIT="5"
# PRICE_CHECKER_COUNT_INSUFFICIENT_DATA="true"
# PRICE_CHECKER_IP_DAILY_CAP="6"
# PRICE_CHECKER_IP_HASH_SALT=""
# PRICE_CHECKER_MAX_CONCURRENT_JOBS="3"
# PRICE_CHECKER_WEB_BASE_URL="https://buildmyhouse.app"

# Stage 7 — guest Paystack payments (one-time fulfilment; NOT a credit wallet)
# Required for checkout. Missing/invalid disables payment initialization (never invent a price).
# Founder-set price in integer kobo (₦5,000 = 500000). Never invent a production price in code.
# PRICE_CHECKER_PRICE_PER_REPORT_KOBO="500000"
# PRICE_CHECKER_PRICING_VERSION="v1-5000-ngn"
# PRICE_CHECKER_CURRENCY="NGN"
# PRICE_CHECKER_TARGET_GROSS_MARGIN_BPS="3000"
# PRICE_CHECKER_MAX_RESEARCH_COST_PER_ITEM_KOBO="500000"
# PRICE_CHECKER_PAYMENT_QUOTE_TTL_MINUTES="15"
# PRICE_CHECKER_FREE_REPORTS_PER_WINDOW="2"
# PRICE_CHECKER_FREE_WINDOW_HOURS="24"
# PRICE_CHECKER_MAX_ITEMS_PER_CHECKOUT="10"
# PRICE_CHECKER_INSUFFICIENT_DATA_COUNTS_AS_COMPLETED="true"
# PRICE_CHECKER_ENTITLEMENT_WINDOW_HOURS="24"
# PRICE_CHECKER_USD_NGN_RATE="1600"
# PRICE_CHECKER_AUTO_REFUND="false"
# PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
# PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
# PAYSTACK_CALLBACK_URL="https://buildmyhouse.app/tools/price-checker/payment/callback"
# PAYSTACK_ENVIRONMENT="test"

# Google OAuth (for authentication)
# Get your credentials from: https://console.cloud.google.com/apis/credentials
# For Expo apps using POST /auth/google/mobile, use the same **Web application** client ID + secret
# as EXPO_PUBLIC_GOOGLE_CLIENT_ID in the mobile/web frontends (token exchange requires matching client).
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
# Web static sites (e.g. https://gc.buildmyhouse.app/): add that exact URL under the Web client's
# "Authorized redirect URIs" and the origin under "Authorized JavaScript origins".

# S3 uploads (recommended for ECS/production)
# Uploads are persisted to S3 instead of ephemeral container storage.
AWS_REGION="eu-north-1"
AWS_S3_BUCKET="buildmyhouse-prod-uploads"
# Optional path prefix inside the bucket (defaults to "uploads")
AWS_S3_UPLOADS_PREFIX="uploads"
# Optional CloudFront/custom domain for public file URLs
# Example: https://assets.buildmyhouse.app
AWS_S3_PUBLIC_BASE_URL=""

# CORS (comma-separated list of allowed origins)
# For production, include your web app URLs:
# ALLOWED_ORIGINS="https://app.buildmyhouse.app,https://gc.buildmyhouse.app,https://admin.buildmyhouse.app"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"

# Server Port (optional, defaults to 3001)
PORT=3001

# GC matching rollout
# Options: "v1" (new strict deterministic scorer) or "legacy" (previous heuristic)
MATCHING_ALGO_VERSION="v1"
# Optional: enable AI reranking on top of deterministic matching.
# AI rerank never blocks matching; if it fails, deterministic ranking is returned.
GC_MATCHING_AI_RERANK_ENABLED="false"
# Optional pool size (min 3, max 40) passed to AI reranker.
GC_MATCHING_AI_POOL_LIMIT="20"
# Optional model for AI reranker.
GC_MATCHING_AI_MODEL="gpt-4o-mini"

# Email notifications (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"
# Optional aliases also supported by the backend:
# RESEND_API_TOKEN="re_your_resend_api_key_here"
# RESEND_KEY="re_your_resend_api_key_here"
# RESEND_TOKEN="re_your_resend_api_key_here"
# Sender email. For testing, use "onboarding@resend.dev" (sends only to your signup email).
# For production, verify your domain at https://resend.com/domains and use e.g. "BuildMyHouse <notifications@yourdomain.com>"
EMAIL_FROM="BuildMyHouse <onboarding@resend.dev>"

# Password reset links
HOMEOWNER_APP_URL="https://buildmyhouse.app"
CONTRACTOR_APP_URL="https://gc.buildmyhouse.app"
ADMIN_DASHBOARD_URL="https://admin.buildmyhouse.app"

# Admin dashboard access allowlist (comma-separated emails).
# If set, only listed admin emails can sign in at /auth/admin/login and access admin routes.
ADMIN_DASHBOARD_ALLOWED_EMAILS="admin@buildmyhouse.com"
