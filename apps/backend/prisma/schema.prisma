// ============================================================================
// PRICE INTELLIGENCE (Stage 3) — docs/price-checker/LOGICAL_DATA_MODEL.md
//
// Separate namespace from the marketplace. `Material` = vendor-controlled
// listing; `PriceObservation` = independently collected market evidence.
// String state fields (not Prisma enums) follow the approved "taxonomy is
// data" decision. Money uses Decimal; floats are prohibited for prices.
// Tri-state inclusion fields use 'included'|'excluded'|'unknown'|
// 'not_applicable' — a missing value never silently means excluded.
// ============================================================================

// ---------------------------------------------------------------------------
// Permanent catalogue (admin-owned; never modified by temporary AI matrices)
// ---------------------------------------------------------------------------

model PriceCategory {
  id        String    @id @default(uuid())
  code      String    @unique // 'structural' | 'envelope' | 'finishes' | 'mep' | 'energy' | 'security'
  name      String
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  families PriceProductFamily[]

  @@map("price_categories")
}

model PriceProductFamily {
  id         String @id @default(uuid())
  key        String @unique // e.g. 'cement'
  name       String
  categoryId String
  kind       String // 'product' | 'system' | 'accessory_set'
  funnelRole String // 'free_traffic' | 'paid_research' | 'both'

  /// Version bumps on any material matrix edit (drives review/staleness logic)
  version Int @default(1)

  normalizedUnitCode      String
  normalizedUnitRationale String
  sellerUnitCodes         Json // string[] of canonical unit codes
  applicableConditions    Json // ProductCondition[]
  /// Full Stage 2 matrix template: attributes, questions, matching rules,
  /// inclusion checks, risk flags (schema-checked against the TS types).
  definition              Json
  definitionSchemaVersion Int    @default(1)

  // Optional-escalation ownership (routing metadata, never a sign-off gate)
  escalationPrimary   String
  escalationSecondary String?
  escalationReason    String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  category          PriceCategory                  @relation(fields: [categoryId], references: [id])
  normalizedUnit    PriceUnit                      @relation("FamilyNormalizedUnit", fields: [normalizedUnitCode], references: [code])
  products          PriceProduct[]
  aliases           PriceAlias[]
  specDefs          PriceSpecificationDefinition[]
  observations      PriceObservation[]
  temporaryMatrices PriceTemporaryMatrix[]
  terminologyChecks PriceTerminologyCheck[]
  requestItems      PriceResearchRequestItem[]
  queries           PriceQuery[]

  @@index([categoryId])
  @@index([funnelRole])
  @@map("price_product_families")
}

/// Permanent named product within a family (Stage 2 "sub-products").
model PriceProduct {
  id            String    @id @default(uuid())
  familyId      String
  key           String // e.g. 'opc-425'
  name          String
  brandId       String?
  specification Json? // fixed known spec values for this named product
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  family       PriceProductFamily @relation(fields: [familyId], references: [id])
  brand        PriceBrand?        @relation(fields: [brandId], references: [id])
  aliases      PriceAlias[]
  observations PriceObservation[]

  @@unique([familyId, key])
  @@index([brandId])
  @@map("price_products")
}

model PriceBrand {
  id             String    @id @default(uuid())
  name           String
  normalizedName String    @unique
  verified       Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products PriceProduct[]

  @@map("price_brands")
}

/// Nigerian market names, aliases and misspellings (admin-editable data).
model PriceAlias {
  id              String    @id @default(uuid())
  familyId        String
  productId       String?
  alias           String
  normalizedAlias String
  source          String    @default("stage2_taxonomy") // 'stage2_taxonomy' | 'spot_check' | 'admin' | 'demand_learning'
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  family  PriceProductFamily @relation(fields: [familyId], references: [id])
  product PriceProduct?      @relation(fields: [productId], references: [id])

  @@unique([familyId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("price_aliases")
}

/// Price-changing attribute definitions, normalised for query paths
/// (full question trees stay inside PriceProductFamily.definition).
model PriceSpecificationDefinition {
  id            String    @id @default(uuid())
  familyId      String
  key           String // e.g. 'grade'
  label         String
  priceChanging Boolean
  allowedValues Json? // string[] where enumerated
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  family PriceProductFamily @relation(fields: [familyId], references: [id])

  @@unique([familyId, key])
  @@map("price_specification_definitions")
}

model PriceUnit {
  id        String    @id @default(uuid())
  code      String    @unique // canonical machine code, e.g. 'bag_50kg'
  label     String
  dimension String // 'count' | 'mass' | 'area' | ...
  aliases   Json // string[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  familiesNormalized     PriceProductFamily[]  @relation("FamilyNormalizedUnit")
  conversionsFrom        PriceConversionRule[] @relation("ConversionFromUnit")
  conversionsTo          PriceConversionRule[] @relation("ConversionToUnit")
  observationsOriginal   PriceObservation[]    @relation("ObservationOriginalUnit")
  observationsNormalized PriceObservation[]    @relation("ObservationNormalizedUnit")

  @@map("price_units")
}

/// Whitelist of permitted conversions. AI can never insert rows here;
/// factorSource 'assumed' does not exist by design.
model PriceConversionRule {
  id            String    @id @default(uuid())
  fromUnitCode  String
  toUnitCode    String
  factorSource  String // 'fixed' | 'manufacturer_spec' | 'product_spec' | 'seller_stated'
  fixedFactor   Decimal?  @db.Decimal(18, 6) // only when factorSource = 'fixed'
  requiredInput String
  note          String?
  version       Int       @default(1)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fromUnit     PriceUnit          @relation("ConversionFromUnit", fields: [fromUnitCode], references: [code])
  toUnit       PriceUnit          @relation("ConversionToUnit", fields: [toUnitCode], references: [code])
  observations PriceObservation[]

  @@unique([fromUnitCode, toUnitCode, factorSource])
  @@map("price_conversion_rules")
}

model PriceServiceFamily {
  id                  String    @id @default(uuid())
  key                 String    @unique
  name                String
  pricingBasis        String // 'labour_only' | 'labour_and_material' | 'either'
  definition          Json // marketNames, pricingUnits, scopeFactors, minimum job charge flag
  escalationPrimary   String
  escalationSecondary String?
  escalationReason    String
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("price_service_families")
}

model PriceLocation {
  id             String    @id @default(uuid())
  code           String    @unique // e.g. 'ng-lagos-ikeja'
  name           String
  type           String // 'country' | 'state' | 'city' | 'local_area' | 'market'
  parentId       String?
  launchPriority Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent   PriceLocation?  @relation("LocationParent", fields: [parentId], references: [id])
  children PriceLocation[] @relation("LocationParent")

  sellers                  PriceSeller[]
  observationsSeller       PriceObservation[]     @relation("ObservationSellerLocation")
  observationsDelivery     PriceObservation[]     @relation("ObservationDeliveryLocation")
  observationsSourceMarket PriceObservation[]     @relation("ObservationSourceMarketLocation")
  researchRequests         PriceResearchRequest[]
  queries                  PriceQuery[]

  @@index([parentId])
  @@index([type])
  @@map("price_locations")
}

model PriceSource {
  id                  String    @id @default(uuid())
  code                String    @unique // machine slug, e.g. 'jiji-ng'
  name                String
  tier                Int // evidence tier (1 = strongest)
  accessStatus        String // SourceAccessStatus values (ethics register)
  accessNote          String?
  baseUrl             String?
  deletedAt           DateTime?
  // Stage 8 — source health monitor
  healthStatus        String    @default("unknown") // 'healthy' | 'degraded' | 'failing' | 'disabled' | 'unknown'
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  successRate         Float?
  parseSuccessRate    Float?
  avgLatencyMs        Int?
  disabledAt          DateTime?
  disabledByAdminId   String?
  disabledReason      String?
  healthNote          String?
  lastCheckedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sellers         PriceSeller[]
  observations    PriceObservation[]
  healthSnapshots SourceHealthSnapshot[]
  reviewCases     PriceReviewCase[]
  disabledByAdmin User?                  @relation("PriceSourceDisabledBy", fields: [disabledByAdminId], references: [id])

  @@index([tier])
  @@index([healthStatus])
  @@map("price_sources")
}

/// Seller identity. Contact fields are SENSITIVE (admin-only exposure).
model PriceSeller {
  id             String    @id @default(uuid())
  name           String
  normalizedName String
  sourceId       String?
  locationId     String?
  /// Optional link to a marketplace vendor account — never required.
  vendorUserId   String?
  verified       Boolean   @default(false)
  contactPhone   String? // sensitive
  contactEmail   String? // sensitive
  contactNote    String? // sensitive
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  source       PriceSource?       @relation(fields: [sourceId], references: [id])
  location     PriceLocation?     @relation(fields: [locationId], references: [id])
  observations PriceObservation[]

  @@unique([normalizedName, sourceId])
  @@index([sourceId])
  @@index([locationId])
  @@map("price_sellers")
}

// ---------------------------------------------------------------------------
// Evidence (append-only observations; private documents)
// ---------------------------------------------------------------------------

/// Independently collected market evidence. APPEND-ONLY: corrections create
/// superseding rows; valid history is never deleted or overwritten.
model PriceObservation {
  id        String  @id @default(uuid())
  familyId  String
  productId String?

  sourceId String
  sellerId String?

  // Location separation (req. 9)
  sellerLocationId       String?
  deliveryLocationId     String?
  sourceMarketLocationId String?

  originalWording  String // seller's own product wording, verbatim
  originalPrice    Decimal @db.Decimal(14, 2)
  currencyCode     String  @default("NGN") @db.Char(3)
  originalQuantity Decimal @default(1) @db.Decimal(14, 4)
  originalUnitCode String

  // Normalisation provenance (req. 6): rule + inputs + factor source + confidence
  normalizedPrice        Decimal? @db.Decimal(14, 4)
  normalizedUnitCode     String?
  conversionRuleId       String?
  conversionInputs       Json? // e.g. { sqmPerCarton: 1.44, statedBy: 'listing' }
  conversionFactorSource String? // mirrors rule.factorSource at time of use
  conversionConfidence   Float?

  condition         String @default("new") // 'new' | 'used' | 'refurbished' | 'rental' | 'unknown'
  availabilityState String @default("unknown") // 'in_stock' | 'out_of_stock' | 'on_request' | 'unknown'

  // Tri-state inclusion fields (req. 5): 'included'|'excluded'|'unknown'|'not_applicable'
  deliveryIncluded     String @default("unknown")
  installationIncluded String @default("unknown")
  vatIncluded          String @default("unknown")
  accessoriesIncluded  String @default("unknown")
  warrantyIncluded     String @default("unknown")

  listingDate DateTime?
  checkedDate DateTime
  expiryDate  DateTime?

  collectionMethod String // 'manual_research' | 'api' | 'merchant_feed' | 'structured_page' | 'user_upload' | 'admin_entry'
  evidenceClass    String // EvidenceClass values (tiered)
  confidence       Float
  riskFlags        Json? // RiskFlag[]

  evidenceDocumentId String?
  /// Optional marketplace provenance (req. 8): set only when this observation
  /// originated from a BuildMyHouse marketplace listing. One-way link.
  materialId         String?

  // Append-only lifecycle (req. 4)
  status                    String  @default("active") // 'active' | 'stale' | 'superseded' | 'rejected' | 'duplicate'
  duplicateFingerprint      String
  supersededByObservationId String?
  rejectionReason           String?
  reviewStatus              String  @default("none") // 'none' | 'flagged' | 'verified'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family                 PriceProductFamily           @relation(fields: [familyId], references: [id])
  product                PriceProduct?                @relation(fields: [productId], references: [id])
  source                 PriceSource                  @relation(fields: [sourceId], references: [id])
  seller                 PriceSeller?                 @relation(fields: [sellerId], references: [id])
  sellerLocation         PriceLocation?               @relation("ObservationSellerLocation", fields: [sellerLocationId], references: [id])
  deliveryLocation       PriceLocation?               @relation("ObservationDeliveryLocation", fields: [deliveryLocationId], references: [id])
  sourceMarketLocation   PriceLocation?               @relation("ObservationSourceMarketLocation", fields: [sourceMarketLocationId], references: [id])
  originalUnit           PriceUnit                    @relation("ObservationOriginalUnit", fields: [originalUnitCode], references: [code])
  normalizedUnit         PriceUnit?                   @relation("ObservationNormalizedUnit", fields: [normalizedUnitCode], references: [code])
  conversionRule         PriceConversionRule?         @relation(fields: [conversionRuleId], references: [id])
  evidenceDocument       PriceEvidenceDocument?       @relation(fields: [evidenceDocumentId], references: [id])
  supersededBy           PriceObservation?            @relation("ObservationSupersession", fields: [supersededByObservationId], references: [id])
  supersedes             PriceObservation[]           @relation("ObservationSupersession")
  attributes             PriceObservationAttribute[]
  correctionsAsOriginal  PriceObservationCorrection[] @relation("CorrectionOriginal")
  correctionsAsCorrected PriceObservationCorrection[] @relation("CorrectionCorrected")
  reviewCases            PriceReviewCase[]

  @@index([familyId, status, checkedDate])
  @@index([duplicateFingerprint])
  @@index([sellerId])
  @@index([sourceId])
  @@index([checkedDate])
  @@index([status])
  @@map("price_observations")
}

model PriceObservationAttribute {
  id            String   @id @default(uuid())
  observationId String
  key           String
  value         String
  createdAt     DateTime @default(now())

  observation PriceObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, key])
  @@index([key, value])
  @@map("price_observation_attributes")
}

/// Uploaded receipts/invoices/quotations. PRIVATE by default (req. 11):
/// original file, redacted file and extracted data are SEPARATE fields;
/// public APIs may only ever read the redacted fields.
model PriceEvidenceDocument {
  id                String    @id @default(uuid())
  uploadedByUserId  String?
  researchRequestId String?
  kind              String // 'receipt' | 'invoice' | 'quotation' | 'photo' | 'price_list'
  state             String    @default("uploaded") // EvidenceDocumentState values
  privateFileRef    String // original document — NEVER publicly exposed
  redactedFileRef   String? // safe derivative
  extractedData     Json? // raw structured extraction (may contain sensitive fields)
  redactedExtract   Json? // extraction after SENSITIVE_EVIDENCE_FIELDS redaction
  sensitive         Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  uploadedBy          User?                     @relation("PriceEvidenceUploader", fields: [uploadedByUserId], references: [id])
  researchRequest     PriceResearchRequest?     @relation(fields: [researchRequestId], references: [id])
  observations        PriceObservation[]
  manualEntries       ManualPriceEntry[]
  merchantSubmissions MerchantPriceSubmission[]

  @@index([uploadedByUserId])
  @@index([researchRequestId])
  @@map("price_evidence_documents")
}

// ---------------------------------------------------------------------------
// Research, reports, billing (req. 3 — separate entities, never one PriceQuery)
// ---------------------------------------------------------------------------

/// Ordinary search / analytics event ONLY. Never used for research execution,
/// reports or billing.
model PriceQuery {
  id              String   @id @default(uuid())
  userId          String?
  rawQuery        String
  normalizedQuery String
  matchedFamilyId String?
  matchType       String? // 'exact_alias' | 'partial' | 'none'
  locationId      String?
  channel         String   @default("search") // 'search' | 'free_daily_check' | 'landing_page'
  createdAt       DateTime @default(now())

  user          User?               @relation("PriceQueries", fields: [userId], references: [id])
  matchedFamily PriceProductFamily? @relation(fields: [matchedFamilyId], references: [id])
  location      PriceLocation?      @relation(fields: [locationId], references: [id])

  @@index([userId, createdAt])
  @@index([normalizedQuery])
  @@map("price_queries")
}

model PriceResearchRequest {
  id                  String   @id @default(uuid())
  userId              String? // null for anonymous free-tier checks (Stage 6)
  anonymousSessionId  String? // anonymous session identifier (Stage 6)
  type                String // 'free_daily' | 'paid_report' | 'quotation_verification' | 'cache_refresh'
  status              String   @default("draft") // 'draft' | 'awaiting_payment' | 'clarification' | 'researching' | 'completed' | 'failed' | 'cancelled'
  requestedLocationId String?
  paymentReference    String? // Paystack ref (paid requests)
  /// Stage 7 — optional link to the one-time paid checkout that entitled this request
  paymentOrderId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User?                      @relation("PriceResearchRequests", fields: [userId], references: [id])
  requestedLocation PriceLocation?             @relation(fields: [requestedLocationId], references: [id])
  paymentOrder      PriceCheckPaymentOrder?    @relation(fields: [paymentOrderId], references: [id])
  items             PriceResearchRequestItem[]
  runs              PriceResearchRun[]
  report            PriceReport?
  creditEvents      PriceCreditLedger[]
  evidenceDocuments PriceEvidenceDocument[]
  temporaryMatrices PriceTemporaryMatrix[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([anonymousSessionId, createdAt])
  @@index([paymentOrderId])
  @@map("price_research_requests")
}

model PriceResearchRequestItem {
  id                     String   @id @default(uuid())
  requestId              String
  familyId               String? // null for Level 3 custom items
  customProductRequestId String?
  rawProductName         String
  specification          Json? // answered attribute values
  status                 String   @default("pending") // 'pending' | 'clarification' | 'researching' | 'successful' | 'insufficient_data' | 'failed' | 'cancelled'
  /// Deterministic billing flag: only 'successful' items count (Stage 1 rules 7/8)
  countsTowardAllowance  Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  request              PriceResearchRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  family               PriceProductFamily?          @relation(fields: [familyId], references: [id])
  customProductRequest PriceCustomProductRequest?   @relation(fields: [customProductRequestId], references: [id])
  runs                 PriceResearchRun[]
  reportItem           PriceReportItem?
  temporaryMatrices    PriceTemporaryMatrix[]
  clarifications       PriceResearchClarification[]

  @@index([requestId])
  @@index([status])
  @@map("price_research_request_items")
}

/// One attempt to collect and analyse data (retries create new runs).
model PriceResearchRun {
  id            String    @id @default(uuid())
  requestId     String
  requestItemId String?
  attemptNumber Int       @default(1)
  status        String    @default("running") // 'running' | 'completed' | 'failed' | 'aborted'
  progressJson  Json? // Stage 6: last reported stage + evidence counters (refresh resilience)
  engineVersion String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  errorSummary  String?
  costTokens    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  request     PriceResearchRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestItem PriceResearchRequestItem? @relation(fields: [requestItemId], references: [id])

  @@index([requestId])
  @@index([requestItemId])
  @@map("price_research_runs")
}

model PriceResearchClarification {
  id            String   @id @default(uuid())
  requestItemId String
  questionJson  Json // MatrixClarificationQuestion shape
  answerJson    Json?
  status        String   @default("asked") // 'asked' | 'answered' | 'unknown' | 'skipped'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requestItem PriceResearchRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  @@index([requestItemId])
  @@map("price_research_clarifications")
}

/// Completed report delivered to the user. Original payload preserved via revisions.
model PriceReport {
  id                   String    @id @default(uuid())
  requestId            String    @unique
  userId               String? // null until an anonymous report is saved to an account (Stage 6)
  anonymousSessionId   String? // anonymous owner session (Stage 6)
  accessToken          String?   @unique // secure random token for anonymous report access (Stage 6)
  status               String // 'delivered' | 'partial' | 'failed'
  payload              Json // current consumer-facing snapshot (original kept in revision 1)
  /// Stage 8 — shown to customer when a material correction lands after delivery
  customerUpdateNotice String?
  currentVersion       Int       @default(1)
  generatedAt          DateTime  @default(now())
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  request     PriceResearchRequest  @relation(fields: [requestId], references: [id])
  user        User?                 @relation("PriceReports", fields: [userId], references: [id])
  items       PriceReportItem[]
  revisions   PriceReportRevision[]
  reviewCases PriceReviewCase[]

  @@index([userId, createdAt])
  @@index([anonymousSessionId, createdAt])
  @@map("price_reports")
}

/// Append-only report revision history. Version 1 = original delivery snapshot.
model PriceReportRevision {
  id               String   @id @default(uuid())
  reportId         String
  version          Int
  payload          Json
  itemsSnapshot    Json
  customerNotice   String?
  materialChange   Boolean  @default(false)
  createdByAdminId String?
  reviewCaseId     String?
  reason           String
  createdAt        DateTime @default(now())

  report         PriceReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdByAdmin User?            @relation("PriceReportRevisionCreator", fields: [createdByAdminId], references: [id])
  reviewCase     PriceReviewCase? @relation(fields: [reviewCaseId], references: [id])

  @@unique([reportId, version])
  @@index([reportId, createdAt])
  @@map("price_report_revisions")
}

model PriceReportItem {
  id            String @id @default(uuid())
  reportId      String
  requestItemId String @unique
  outcome       String // 'priced' | 'insufficient_data' | 'failed'

  // Money: Decimal only (req. 6)
  rangeLow     Decimal? @db.Decimal(14, 2)
  rangeHigh    Decimal? @db.Decimal(14, 2)
  medianPrice  Decimal? @db.Decimal(14, 2)
  typicalPrice Decimal? @db.Decimal(14, 2)
  currencyCode String   @default("NGN") @db.Char(3)
  unitCode     String?

  sourceCount Int   @default(0)
  confidence  Float @default(0)

  // Location fallback provenance (req. 9)
  locationMatchLevel String? // 'exact_local' | 'same_city' | 'same_state' | 'nearby_state' | 'national'
  fallbackLevel      Int     @default(0) // 0 = exact, higher = wider fallback

  payload   Json // per-item detail: observations used, exclusions, assumptions
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report      PriceReport              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  requestItem PriceResearchRequestItem @relation(fields: [requestItemId], references: [id])
  reviewCases PriceReviewCase[]

  @@index([reportId])
  @@index([outcome])
  @@map("price_report_items")
}

/// APPEND-ONLY credit accounting (req. 3). Balance = SUM(delta) per user.
/// Never maintained as a mutable counter. Rows are never updated or deleted.
model PriceCreditLedger {
  id               String   @id @default(uuid())
  userId           String
  eventType        String // 'credit_purchased' | 'credit_reserved' | 'credit_consumed' | 'credit_released' | 'credit_refunded' | 'admin_adjustment'
  /// Signed credit delta: purchases/releases/refunds positive; reservations/consumption negative.
  delta            Int
  requestId        String?
  reportId         String?
  paymentReference String?
  reason           String
  createdByAdminId String?
  createdAt        DateTime @default(now())

  user    User                  @relation("PriceCreditEvents", fields: [userId], references: [id])
  request PriceResearchRequest? @relation(fields: [requestId], references: [id])

  @@index([userId, createdAt])
  @@index([requestId])
  @@map("price_credit_ledger")
}

// ---------------------------------------------------------------------------
// Temporary AI matrices (request-scoped; never permanent catalogue records)
// ---------------------------------------------------------------------------

/// AI-generated temporary specification matrix with FULL provenance (req. 2).
/// Belongs to one request item. Cannot modify or publish permanent catalogue
/// records — promotion happens only via PriceTaxonomyChangeRequest.
model PriceTemporaryMatrix {
  id            String @id @default(uuid())
  requestId     String
  requestItemId String

  matchedFamilyId String?
  rawInput        String // raw user input verbatim
  matrixJson      Json // the generated matrix (schema-validated)

  // Reproducibility / audit — never store the final JSON alone
  modelName       String
  modelResponseId String?
  promptVersion   String
  schemaVersion   Int
  inputHash       String // hash of prompt inputs for reproducibility

  validationStatus      String // 'valid' | 'invalid' | 'invalid_after_retry'
  validationErrors      Json? // string[]
  confidence            Float
  uncertaintyReasons    Json? // string[]
  readinessState        String // MatrixConfidenceState values
  escalationRecommended Boolean @default(false)

  generatedAt          DateTime  @default(now())
  expiresAt            DateTime?
  supersededByMatrixId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request       PriceResearchRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestItem   PriceResearchRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  matchedFamily PriceProductFamily?      @relation(fields: [matchedFamilyId], references: [id])
  supersededBy  PriceTemporaryMatrix?    @relation("MatrixSupersession", fields: [supersededByMatrixId], references: [id])
  supersedes    PriceTemporaryMatrix[]   @relation("MatrixSupersession")

  @@index([requestItemId])
  @@index([inputHash])
  @@map("price_temporary_matrices")
}

// ---------------------------------------------------------------------------
// Custom products, taxonomy change control, spot checks, optional reviews
// ---------------------------------------------------------------------------

/// Level 3 custom request: PRIVATE, request-specific candidate by default
/// (req. 7). AI suggestions are proposals only; publication requires an
/// approved PriceTaxonomyChangeRequest.
model PriceCustomProductRequest {
  id              String  @id @default(uuid())
  userId          String?
  rawQuery        String
  normalizedQuery String
  matchedFamilyId String?
  isPrivate       Boolean @default(true)
  status          String  @default("private_candidate") // 'private_candidate' | 'matched' | 'unsupported' | 'insufficiently_specified' | 'promotion_proposed' | 'promoted' | 'rejected'
  approvalStatus  String  @default("none") // 'none' | 'proposed' | 'approved' | 'rejected'
  aiSuggestion    Json? // { kind: 'existing_family_match'|'new_alias'|'new_product'|'new_family', payload }

  // Demand learning
  requestCount    Int      @default(1)
  paidIntentCount Int      @default(0)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User?                        @relation("PriceCustomRequests", fields: [userId], references: [id])
  requestItems           PriceResearchRequestItem[]
  taxonomyChangeRequests PriceTaxonomyChangeRequest[]

  @@index([approvalStatus])
  @@index([normalizedQuery])
  @@map("price_custom_product_requests")
}

/// The ONLY path by which anything becomes a permanent catalogue record.
/// Admin-approved with audit history; decisions are append-only.
model PriceTaxonomyChangeRequest {
  id                     String    @id @default(uuid())
  type                   String // 'new_family' | 'new_product' | 'new_alias' | 'family_edit' | 'promotion_from_custom'
  payload                Json // proposed change (may be AI-drafted)
  proposedBy             String // 'ai_suggestion' | 'demand_learning' | 'admin' | 'spot_check'
  customProductRequestId String?
  status                 String    @default("proposed") // 'proposed' | 'approved' | 'rejected'
  approvedByAdminId      String?
  decidedAt              DateTime?
  decisionNote           String?
  auditLog               Json? // append-only entries [{at, actor, action}]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  approvedByAdmin      User?                      @relation("PriceTaxonomyApprovals", fields: [approvedByAdminId], references: [id])
  customProductRequest PriceCustomProductRequest? @relation(fields: [customProductRequestId], references: [id])

  @@index([status])
  @@map("price_taxonomy_change_requests")
}

/// APPEND-ONLY GPT terminology spot-check records (never professional
/// certification). Mirrors scripts/data/terminology-check-results.json.
model PriceTerminologyCheck {
  id                     String   @id @default(uuid())
  familyId               String
  modelName              String
  modelResponseId        String?
  sourceReference        String
  dateChecked            DateTime
  findings               Json
  validationResult       String // 'valid' | 'invalid_after_retry' | 'call_failed' | 'dry_run'
  confidence             Float?
  adminCorrectionApplied Boolean  @default(false)
  createdAt              DateTime @default(now())

  family PriceProductFamily @relation(fields: [familyId], references: [id])

  @@index([familyId])
  @@map("price_terminology_checks")
}

/// OPTIONAL escalation review records only (founder decision 2026-07-28:
/// no mandatory professional reviews). Append-only; versioned against the
/// family version so stale approvals demote honestly.
model PriceProfessionalReview {
  id                    String   @id @default(uuid())
  familyKey             String // family or service key
  familyVersion         Int
  reviewerName          String
  reviewerProfession    String
  relevantQualification String
  reviewScope           String
  outcome               String // 'approved' | 'approved_with_changes' | 'changes_requested'
  notes                 String
  evidenceAttachmentRef String?
  adminApproverId       String?
  reviewDate            DateTime
  createdAt             DateTime @default(now())

  adminApprover User? @relation("PriceReviewApprovals", fields: [adminApproverId], references: [id])

  @@index([familyKey, familyVersion])
  @@map("price_professional_reviews")
}

/// Idempotent-seed bookkeeping: records which seed versions have been applied.
model PriceSeedMeta {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. 'taxonomy_seed_version'
  value     String
  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("price_seed_meta")
}

// ---------------------------------------------------------------------------
// Stage 7 — guest Paystack payments (one-time fulfilment, NOT a credit wallet)
// All money fields are integer kobo. PriceCreditLedger is unused by this flow.
// ---------------------------------------------------------------------------

/// Immutable server-side quote for a checkout attempt. Client never sets amounts.
model PriceCheckPaymentQuote {
  id                   String   @id @default(uuid())
  sessionId            String // client Price Checker session id (same as anonymous session for guests)
  anonymousSessionId   String?
  userId               String?
  email                String?
  requestedItemCount   Int
  freeItemCountApplied Int
  chargeableItemCount  Int
  unitPriceKobo        Int
  subtotalKobo         Int
  discountKobo         Int      @default(0)
  totalKobo            Int
  currency             String   @default("NGN") @db.Char(3)
  pricingVersion       String
  /// Immutable snapshot of requested items + per-line free/chargeable amounts (kobo).
  itemsJson            Json
  status               String   @default("ready") // 'ready' | 'payment_initialized' | 'paid' | 'expired' | 'cancelled'
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orders PriceCheckPaymentOrder[]

  @@index([sessionId, createdAt])
  @@index([anonymousSessionId, createdAt])
  @@index([status, expiresAt])
  @@map("price_check_payment_quotes")
}

/// One Paystack checkout. Entitlement is the paid order itself — never a reusable wallet.
model PriceCheckPaymentOrder {
  id                     String    @id @default(uuid())
  quoteId                String
  sessionId              String
  anonymousSessionId     String?
  userId                 String?
  customerEmail          String
  provider               String    @default("paystack")
  providerReference      String    @unique
  providerAccessCode     String?
  providerTransactionId  String?
  amountExpectedKobo     Int
  amountPaidKobo         Int?
  currency               String    @default("NGN") @db.Char(3)
  status                 String    @default("initialized") // 'initialized' | 'pending' | 'success' | 'partially_refunded' | 'refunded' | 'failed' | 'abandoned'
  fulfilmentStatus       String    @default("not_started") // 'not_started' | 'ready' | 'processing' | 'partially_complete' | 'complete' | 'technical_failure' | 'refunded'
  initializedAt          DateTime  @default(now())
  paidAt                 DateTime?
  failedAt               DateTime?
  refundedAmountKobo     Int       @default(0)
  entitlementExpiresAt   DateTime?
  recoveryTokenHash      String?   @unique
  recoveryTokenExpiresAt DateTime?
  metadataSafe           Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  quote            PriceCheckPaymentQuote      @relation(fields: [quoteId], references: [id])
  lineItems        PriceCheckPaymentLineItem[]
  events           PriceCheckPaymentEvent[]
  refunds          PriceCheckRefund[]
  unitEconomics    PriceCheckUnitEconomics[]
  researchRequests PriceResearchRequest[]

  @@index([quoteId])
  @@index([sessionId, createdAt])
  @@index([anonymousSessionId, createdAt])
  @@index([status, fulfilmentStatus])
  @@index([customerEmail])
  @@map("price_check_payment_orders")
}

model PriceCheckPaymentLineItem {
  id                     String    @id @default(uuid())
  paymentOrderId         String
  clientItemKey          String // stable key within the quote/order
  familyKey              String
  kind                   String // 'product' | 'service'
  productLabel           String
  locationKey            String
  rawProductName         String
  answersJson            Json
  free                   Boolean   @default(false)
  amountKobo             Int
  researchRequestId      String?
  reportId               String?
  fulfilmentStatus       String    @default("pending") // 'pending' | 'ready' | 'processing' | 'fulfilled' | 'technical_failure' | 'refunded'
  technicalFailureReason String?
  fulfilledAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  paymentOrder  PriceCheckPaymentOrder   @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  unitEconomics PriceCheckUnitEconomics?

  @@unique([paymentOrderId, clientItemKey])
  @@index([paymentOrderId, fulfilmentStatus])
  @@index([reportId])
  @@map("price_check_payment_line_items")
}

/// Append-only provider webhook/callback events (idempotent via eventFingerprint).
model PriceCheckPaymentEvent {
  id                String    @id @default(uuid())
  paymentOrderId    String?
  providerEventType String
  eventFingerprint  String    @unique
  signatureValid    Boolean
  processed         Boolean   @default(false)
  safePayload       Json
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  paymentOrder PriceCheckPaymentOrder? @relation(fields: [paymentOrderId], references: [id])

  @@index([paymentOrderId, receivedAt])
  @@map("price_check_payment_events")
}

model PriceCheckRefund {
  id               String    @id @default(uuid())
  paymentOrderId   String
  lineItemId       String?
  providerRefundId String?
  amountKobo       Int
  reasonCode       String // 'technical_failure' | 'partial_technical_failure' | 'support_adjustment' | ...
  status           String    @default("pending") // 'pending' | 'processing' | 'completed' | 'failed'
  initiatedAt      DateTime  @default(now())
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  paymentOrder PriceCheckPaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  @@index([paymentOrderId])
  @@index([status])
  @@map("price_check_refunds")
}

/// Per paid line-item unit economics (integer kobo + optional USD research cost).
model PriceCheckUnitEconomics {
  id                    String   @id @default(uuid())
  paymentOrderId        String
  lineItemId            String   @unique
  reportId              String?
  grossRevenueKobo      Int
  paymentFeeKobo        Int?
  researchCostUsdMicros Int? // estimated research cost in USD micros (1e-6 USD)
  searchCostKobo        Int      @default(0)
  aiCostKobo            Int      @default(0)
  extractionCostKobo    Int      @default(0)
  pdfCostKobo           Int      @default(0)
  storageCostKobo       Int      @default(0)
  refundCostKobo        Int      @default(0)
  totalVariableCostKobo Int
  netRevenueKobo        Int
  grossMarginKobo       Int
  grossMarginBps        Int
  costDataComplete      Boolean  @default(false)
  calculatedAt          DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  paymentOrder PriceCheckPaymentOrder    @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  lineItem     PriceCheckPaymentLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  @@index([paymentOrderId])
  @@index([calculatedAt])
  @@map("price_check_unit_economics")
}

// ---------------------------------------------------------------------------
// Stage 8 — Price Intelligence operations (admin review cockpit)
// Humans only for exceptions; normal reports stay auto-delivered.
// Corrections NEVER overwrite original PriceObservation evidence.
// ---------------------------------------------------------------------------

model PriceReviewCase {
  id                      String    @id @default(uuid())
  caseType                String // 'low_confidence' | 'insufficient_data' | 'outlier' | 'source_failure' | 'manual_entry' | 'merchant_submission' | 'customer_dispute' | 'catalogue'
  priority                String // 'critical' | 'high' | 'medium' | 'low'
  priorityScore           Int
  priorityReason          String
  status                  String    @default("open") // review-state-machine statuses
  triggerCode             String
  triggerDetails          Json?
  productFamilyKey        String?
  productLabel            String?
  locationKey             String?
  confidenceLabel         String?
  confidenceScore         Float?
  reportId                String?
  reportItemId            String?
  observationId           String?
  sourceId                String?
  merchantSubmissionId    String?
  manualEntryItemId       String?
  customerImpactCount     Int       @default(1)
  paidCustomerImpactCount Int       @default(0)
  assignedReviewerId      String?
  dueAt                   DateTime?
  openedAt                DateTime  @default(now())
  resolvedAt              DateTime?
  closedAt                DateTime?
  createdByType           String    @default("system") // 'system' | 'admin' | 'customer'
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  report             PriceReport?                 @relation(fields: [reportId], references: [id])
  reportItem         PriceReportItem?             @relation(fields: [reportItemId], references: [id])
  observation        PriceObservation?            @relation(fields: [observationId], references: [id])
  source             PriceSource?                 @relation(fields: [sourceId], references: [id])
  merchantSubmission MerchantPriceSubmission?     @relation(fields: [merchantSubmissionId], references: [id])
  manualEntryItem    ManualPriceEntryItem?        @relation(fields: [manualEntryItemId], references: [id])
  assignedReviewer   User?                        @relation("PriceReviewCaseAssignee", fields: [assignedReviewerId], references: [id])
  events             PriceReviewCaseEvent[]
  corrections        PriceObservationCorrection[]
  reportRevisions    PriceReportRevision[]

  @@index([status, priorityScore])
  @@index([status, dueAt])
  @@index([assignedReviewerId, status])
  @@index([caseType, status])
  @@index([reportId])
  @@index([productFamilyKey])
  @@index([openedAt])
  @@map("price_review_cases")
}

model PriceReviewCaseEvent {
  id           String   @id @default(uuid())
  caseId       String
  eventType    String // 'created' | 'assigned' | 'transition' | 'note' | 'priority_override' | 'correction' | 'approval' | 'rejection'
  fromStatus   String?
  toStatus     String?
  note         String?
  metadata     Json?
  actorAdminId String?
  createdAt    DateTime @default(now())

  case  PriceReviewCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User?           @relation("PriceReviewCaseEventActor", fields: [actorAdminId], references: [id])

  @@index([caseId, createdAt])
  @@map("price_review_case_events")
}

/// Links original observation to a superseding corrected observation (never overwrites).
model PriceObservationCorrection {
  id                     String   @id @default(uuid())
  originalObservationId  String
  correctedObservationId String
  correctionType         String // 'price' | 'unit' | 'spec' | 'location' | 'inclusion' | 'rejection' | 'structured_fields'
  changedFields          Json
  reason                 String
  reviewCaseId           String?
  createdByAdminId       String
  createdAt              DateTime @default(now())

  originalObservation  PriceObservation @relation("CorrectionOriginal", fields: [originalObservationId], references: [id])
  correctedObservation PriceObservation @relation("CorrectionCorrected", fields: [correctedObservationId], references: [id])
  reviewCase           PriceReviewCase? @relation(fields: [reviewCaseId], references: [id])
  createdBy            User             @relation("PriceObservationCorrectionCreator", fields: [createdByAdminId], references: [id])

  @@index([originalObservationId])
  @@index([reviewCaseId])
  @@map("price_observation_corrections")
}

model ManualPriceEntry {
  id                 String    @id @default(uuid())
  status             String    @default("draft") // 'draft' | 'submitted' | 'approved' | 'rejected' | 'partially_approved'
  title              String
  notes              String?
  evidenceFileRef    String?
  evidenceDocumentId String?
  locationKey        String?
  createdByAdminId   String
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy        User                   @relation("ManualPriceEntryCreator", fields: [createdByAdminId], references: [id])
  reviewedBy       User?                  @relation("ManualPriceEntryReviewer", fields: [reviewedByAdminId], references: [id])
  evidenceDocument PriceEvidenceDocument? @relation(fields: [evidenceDocumentId], references: [id])
  items            ManualPriceEntryItem[]

  @@index([status, createdAt])
  @@index([createdByAdminId])
  @@map("manual_price_entries")
}

model ManualPriceEntryItem {
  id               String   @id @default(uuid())
  entryId          String
  familyKey        String?
  productLabel     String
  brandName        String?
  originalWording  String
  originalPrice    Decimal  @db.Decimal(14, 2)
  currencyCode     String   @default("NGN") @db.Char(3)
  originalUnitCode String
  locationKey      String?
  specification    Json?
  status           String   @default("pending") // 'pending' | 'approved' | 'rejected'
  rejectionReason  String?
  observationId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entry       ManualPriceEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reviewCases PriceReviewCase[]

  @@index([entryId, status])
  @@map("manual_price_entry_items")
}

model PriceMerchant {
  id                 String    @id @default(uuid())
  businessName       String
  tradingName        String?
  sellerType         String    @default("retailer") // 'retailer' | 'wholesaler' | 'distributor' | 'manufacturer' | 'market_trader'
  city               String?
  state              String?
  verificationStatus String    @default("unverified") // 'unverified' | 'pending' | 'verified' | 'rejected' | 'suspended'
  sourceTier         Int       @default(3)
  riskNotes          String?
  contactPhone       String? // sensitive
  contactEmail       String? // sensitive
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  submissions MerchantPriceSubmission[]

  @@index([verificationStatus])
  @@index([state, city])
  @@map("price_merchants")
}

model MerchantPriceSubmission {
  id                 String    @id @default(uuid())
  merchantId         String?
  status             String    @default("draft") // 'draft' | 'submitted' | 'in_review' | 'approved' | 'rejected' | 'partially_approved'
  channel            String    @default("whatsapp") // 'whatsapp' | 'email' | 'upload' | 'admin'
  title              String
  notes              String?
  evidenceFileRef    String?
  evidenceDocumentId String?
  createdByAdminId   String?
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  merchant         PriceMerchant?                @relation(fields: [merchantId], references: [id])
  createdBy        User?                         @relation("MerchantSubmissionCreator", fields: [createdByAdminId], references: [id])
  evidenceDocument PriceEvidenceDocument?        @relation(fields: [evidenceDocumentId], references: [id])
  items            MerchantPriceSubmissionItem[]
  reviewCases      PriceReviewCase[]

  @@index([status, createdAt])
  @@index([merchantId])
  @@map("merchant_price_submissions")
}

model MerchantPriceSubmissionItem {
  id                String    @id @default(uuid())
  submissionId      String
  familyKey         String?
  productLabel      String
  brandName         String?
  originalWording   String
  originalPrice     Decimal   @db.Decimal(14, 2)
  currencyCode      String    @default("NGN") @db.Char(3)
  originalUnitCode  String
  locationKey       String?
  specification     Json?
  status            String    @default("pending") // 'pending' | 'approved' | 'rejected'
  rejectionReason   String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  observationId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  submission MerchantPriceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewedBy User?                   @relation("MerchantItemReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([submissionId, status])
  @@map("merchant_price_submission_items")
}

model SourceHealthSnapshot {
  id                  String   @id @default(uuid())
  sourceId            String
  healthStatus        String
  successRate         Float?
  parseSuccessRate    Float?
  avgLatencyMs        Int?
  consecutiveFailures Int      @default(0)
  checkType           String   @default("manual") // 'manual' | 'scheduled' | 'pipeline'
  note                String?
  checkedByAdminId    String?
  createdAt           DateTime @default(now())

  source PriceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt])
  @@map("source_health_snapshots")
}

/// Append-only audit log. No update/delete APIs.
model PriceIntelligenceAuditLog {
  id           String   @id @default(uuid())
  action       String
  entityType   String
  entityId     String?
  actorAdminId String?
  beforeJson   Json?
  afterJson    Json?
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation("PriceIntelligenceAuditActor", fields: [actorAdminId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
  @@map("price_intelligence_audit_log")
}

model PriceIntelligenceReviewer {
  id                String   @id @default(uuid())
  adminUserId       String   @unique
  active            Boolean  @default(true)
  categoryScope     Json? // string[] of family/category keys; null = all
  availabilityNotes String?
  maximumOpenCases  Int      @default(25)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  adminUser User @relation("PriceIntelligenceReviewerUser", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([active])
  @@map("price_intelligence_reviewers")
}

/// Singleton-style key-value settings (SLAs, thresholds, etc.).
model PriceIntelligenceSetting {
  id               String   @id @default(uuid())
  key              String   @unique
  valueJson        Json
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("price_intelligence_settings")
}

/// Optional search-demand mapping for unmatched terms (aggregates may also use PriceQuery).
model PriceUnmatchedTerm {
  id                 String   @id @default(uuid())
  normalizedTerm     String   @unique
  sampleRawQuery     String
  requestCount       Int      @default(1)
  paidIntentCount    Int      @default(0)
  lastSeenAt         DateTime @default(now())
  firstSeenAt        DateTime @default(now())
  suggestedFamilyKey String?
  status             String   @default("open") // 'open' | 'mapped' | 'ignored'
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, requestCount])
  @@index([lastSeenAt])
  @@map("price_unmatched_terms")
}

// =============================================================================
// People & HR
// =============================================================================

model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  headUserId  String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  head       User?          @relation("DepartmentHead", fields: [headUserId], references: [id])
  positions  Position[]
  staff      StaffProfile[]
  candidates Candidate[]

  @@index([archivedAt])
  @@map("hr_departments")
}

model Position {
  id                    String   @id @default(uuid())
  departmentId          String
  name                  String
  description           String?
  purpose               String?
  responsibilities      String[] @default([])
  requiredSkills        String[] @default([])
  reportsToPositionId   String?
  allowedWorkforceTypes String[] @default([])
  kpiDefinitions        Json?
  compensationMin       Decimal? @db.Decimal(14, 2)
  compensationMax       Decimal? @db.Decimal(14, 2)
  currencyCode          String   @default("NGN") @db.Char(3)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  department        Department     @relation(fields: [departmentId], references: [id])
  reportsToPosition Position?      @relation("PositionReporting", fields: [reportsToPositionId], references: [id])
  directReports     Position[]     @relation("PositionReporting")
  staff             StaffProfile[]
  candidates        Candidate[]

  @@unique([departmentId, name])
  @@index([departmentId, active])
  @@map("hr_positions")
}

model StaffProfile {
  id                      String    @id @default(uuid())
  userId                  String?   @unique
  candidateId             String?   @unique
  firstName               String
  lastName                String
  fullName                String
  email                   String
  phone                   String?
  pictureUrl              String?
  address                 String?
  location                String?
  emergencyContact        String?
  emergencyPhone          String?
  workforceType           String // employee | fixed_term | consultant | independent_contractor | intern | freelancer | executive | temporary
  departmentId            String?
  positionId              String?
  managerUserId           String?
  workLocation            String?
  startDate               DateTime?
  endDate                 DateTime?
  probationEndDate        DateTime?
  employmentStatus        String    @default("onboarding") // onboarding | active | probation | leave | suspended | exited
  // Compensation — restricted; never return without hr.compensation.view
  baseCompensation        Decimal?  @db.Decimal(14, 2)
  transportAllowance      Decimal?  @db.Decimal(14, 2)
  communicationAllowance  Decimal?  @db.Decimal(14, 2)
  otherAllowances         Decimal?  @db.Decimal(14, 2)
  bonusNotes              String?
  paymentFrequency        String? // monthly | weekly | per_project | retainer
  currencyCode            String    @default("NGN") @db.Char(3)
  // Offboarding
  exitDate                DateTime?
  exitReason              String?
  finalHandoverNotes      String?
  companyPropertyReturned Boolean   @default(false)
  accountDisabledAt       DateTime?
  permissionsRevokedAt    DateTime?
  documentsArchivedAt     DateTime?
  exitNotes               String?
  notes                   String?
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user               User?                   @relation("StaffProfileUser", fields: [userId], references: [id])
  candidate          Candidate?              @relation("HiredCandidate", fields: [candidateId], references: [id])
  department         Department?             @relation(fields: [departmentId], references: [id])
  position           Position?               @relation(fields: [positionId], references: [id])
  manager            User?                   @relation("StaffManager", fields: [managerUserId], references: [id])
  roleAssignments    StaffRoleAssignment[]
  documents          HrDocument[]
  onboardingTasks    OnboardingTask[]
  performanceGoals   StaffPerformanceGoal[]
  performanceReviews PerformanceReview[]
  communications     HrCommunication[]
  policyAcks         PolicyAcknowledgement[]
  adminAccessProfile AdminAccessProfile?     @relation("AdminAccessProfileStaff")

  @@index([employmentStatus])
  @@index([departmentId])
  @@index([workforceType])
  @@index([email])
  @@map("hr_staff_profiles")
}

model Candidate {
  id                     String    @id @default(uuid())
  firstName              String
  lastName               String
  fullName               String
  email                  String
  phone                  String?
  location               String?
  departmentId           String?
  positionId             String?
  cvUrl                  String?
  applicationDate        DateTime  @default(now())
  source                 String?
  stage                  String    @default("applied") // applied | screening | interview | assessment | paid_pilot | reference_check | offer | hired | rejected | withdrawn
  hiringManagerUserId    String?
  interviewDate          DateTime?
  interviewNotes         String?
  interviewScore         Float?
  assessmentInstructions String?
  assessmentSubmission   String?
  assessmentScore        Float?
  pilotNotes             String?
  referencesJson         Json?
  referenceCheckNotes    String?
  offerDetails           String?
  rejectionReason        String?
  internalNotes          String?
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  department     Department?           @relation(fields: [departmentId], references: [id])
  position       Position?             @relation(fields: [positionId], references: [id])
  hiringManager  User?                 @relation("CandidateHiringManager", fields: [hiringManagerUserId], references: [id])
  hiredStaff     StaffProfile?         @relation("HiredCandidate")
  stageEvents    CandidateStageEvent[]
  documents      HrDocument[]
  communications HrCommunication[]

  @@index([stage])
  @@index([departmentId, positionId])
  @@index([email])
  @@map("hr_candidates")
}

model CandidateStageEvent {
  id          String   @id @default(uuid())
  candidateId String
  fromStage   String?
  toStage     String
  note        String?
  actorUserId String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@map("hr_candidate_stage_events")
}

model AdminPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  groupLabel  String
  description String?
  isCritical  Boolean  @default(false)
  createdAt   DateTime @default(now())

  rolePermissions AdminRolePermission[]
  overrides       AdminPermissionOverride[]
  accessRequests  AdminAccessRequest[]

  @@index([groupLabel])
  @@map("hr_admin_permissions")
}

model AdminRole {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions      AdminRolePermission[]
  assignments      StaffRoleAssignment[]
  userAssignments  AdminUserRoleAssignment[]

  @@map("hr_admin_roles")
}

model AdminRolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("hr_admin_role_permissions")
}

model StaffRoleAssignment {
  id              String    @id @default(uuid())
  staffProfileId  String
  roleId          String
  grantedByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  role         AdminRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("StaffRoleAssignmentGranter", fields: [grantedByUserId], references: [id])

  @@index([staffProfileId, revokedAt])
  @@index([roleId])
  @@map("hr_staff_role_assignments")
}

model HrDocument {
  id               String    @id @default(uuid())
  category         String // cv | id | employment_contract | consultancy_agreement | nda | offer_letter | reference | probation_letter | performance_warning | promotion_letter | termination_letter | other
  staffProfileId   String?
  candidateId      String?
  fileUrl          String
  fileName         String?
  uploadedByUserId String?
  effectiveDate    DateTime?
  expiryDate       DateTime?
  signatureStatus  String    @default("unsigned") // unsigned | pending | signed
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staffProfile StaffProfile? @relation(fields: [staffProfileId], references: [id])
  candidate    Candidate?    @relation(fields: [candidateId], references: [id])
  uploadedBy   User?         @relation("HrDocumentUploader", fields: [uploadedByUserId], references: [id])

  @@index([staffProfileId])
  @@index([candidateId])
  @@index([expiryDate])
  @@index([category])
  @@map("hr_documents")
}

model OnboardingTask {
  id                String    @id @default(uuid())
  staffProfileId    String
  key               String
  title             String
  status            String    @default("pending") // pending | completed | waived
  completedAt       DateTime?
  completedByUserId String?
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  completedBy  User?        @relation("OnboardingTaskCompleter", fields: [completedByUserId], references: [id])

  @@unique([staffProfileId, key])
  @@index([staffProfileId, status])
  @@map("hr_onboarding_tasks")
}

model StaffPerformanceGoal {
  id                 String   @id @default(uuid())
  staffProfileId     String
  kpi                String
  target             String
  period             String // e.g. 2026-08 or Q3-2026
  actualResult       String?
  status             String   @default("open") // open | on_track | at_risk | met | missed
  managerComments    String?
  reviewType         String   @default("monthly") // monthly | probation | performance_review | improvement_plan
  bonusEligibleNotes String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, period])
  @@map("hr_staff_performance_goals")
}

model PerformanceReview {
  id              String   @id @default(uuid())
  staffProfileId  String
  reviewType      String // probation | performance_review | improvement_plan
  period          String?
  summary         String?
  rating          String?
  managerComments String?
  reviewedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, reviewedAt])
  @@map("hr_performance_reviews")
}

model HrCommunication {
  id             String    @id @default(uuid())
  templateKey    String?
  subject        String
  bodyText       String?
  bodyHtml       String?
  recipientEmail String
  staffProfileId String?
  candidateId    String?
  status         String    @default("queued") // queued | sent | failed
  sentByUserId   String?
  providerId     String?
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  staffProfile StaffProfile? @relation(fields: [staffProfileId], references: [id])
  candidate    Candidate?    @relation(fields: [candidateId], references: [id])
  sentBy       User?         @relation("HrCommunicationSender", fields: [sentByUserId], references: [id])

  @@index([candidateId, createdAt])
  @@index([staffProfileId, createdAt])
  @@index([status, createdAt])
  @@map("hr_communications")
}

model HrPolicy {
  id                 String    @id @default(uuid())
  title              String
  category           String // employment | conduct_ethics | human_resources | operations | sales | marketing | finance_expenses | compliance | data_security | communication | health_safety | leave_attendance
  content            String
  version            String    @default("1.0")
  effectiveDate      DateTime?
  status             String    @default("draft") // draft | active | archived
  appliesCompanyWide Boolean   @default(true)
  departmentIds      String[]  @default([])
  positionIds        String[]  @default([])
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy        User?                   @relation("HrPolicyCreator", fields: [createdByUserId], references: [id])
  updatedBy        User?                   @relation("HrPolicyUpdater", fields: [updatedByUserId], references: [id])
  acknowledgements PolicyAcknowledgement[]

  @@index([status, category])
  @@map("hr_policies")
}

model PolicyAcknowledgement {
  id             String   @id @default(uuid())
  policyId       String
  staffProfileId String
  version        String
  acknowledgedAt DateTime @default(now())

  policy       HrPolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([policyId, staffProfileId, version])
  @@index([policyId])
  @@map("hr_policy_acknowledgements")
}

model HrAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  summary     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("HrAuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("hr_audit_log")
}

/// System access identity — separate from employment (StaffProfile).
model AdminAccessProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  staffProfileId    String?   @unique
  /// employee | consultant | executive | external | auditor | technical_partner | service_account | test_account
  accessRelationship String   @default("external")
  /// invited | active | suspended | revoked | expired
  status            String    @default("invited")
  organisation      String?
  accessReason      String?
  sponsorUserId     String?
  accessStartsAt    DateTime?
  accessExpiresAt   DateTime?
  suspendedAt       DateTime?
  suspendedUntil    DateTime?
  suspendReason     String?
  revokedAt         DateTime?
  revokeReason      String?
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User                      @relation("AdminAccessProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile?             @relation("AdminAccessProfileStaff", fields: [staffProfileId], references: [id], onDelete: SetNull)
  sponsor      User?                     @relation("AdminAccessProfileSponsor", fields: [sponsorUserId], references: [id], onDelete: SetNull)
  createdBy    User?                     @relation("AdminAccessProfileCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  roleAssignments AdminUserRoleAssignment[]
  overrides    AdminPermissionOverride[]
  invitations  AdminInvitation[]

  @@index([status])
  @@index([accessExpiresAt])
  @@index([accessRelationship])
  @@map("admin_access_profiles")
}

model AdminUserRoleAssignment {
  id              String    @id @default(uuid())
  accessProfileId String
  roleId          String
  grantedByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  accessProfile AdminAccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Cascade)
  role          AdminRole          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy     User?              @relation("AdminUserRoleGranter", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([accessProfileId, revokedAt])
  @@index([roleId])
  @@unique([accessProfileId, roleId])
  @@map("admin_user_role_assignments")
}

/// Explicit grant/deny. Priority: deny > grant > role > default deny.
model AdminPermissionOverride {
  id              String    @id @default(uuid())
  accessProfileId String
  permissionId    String
  /// grant | deny
  effect          String
  reason          String?
  grantedByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  accessProfile AdminAccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Cascade)
  permission    AdminPermission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy     User?              @relation("AdminPermissionOverrideGranter", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([accessProfileId, revokedAt])
  @@index([permissionId])
  @@unique([accessProfileId, permissionId, effect])
  @@map("admin_permission_overrides")
}

model AdminInvitation {
  id              String    @id @default(uuid())
  accessProfileId String
  email           String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  accessProfile AdminAccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Cascade)
  createdBy     User?              @relation("AdminInvitationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([accessProfileId, expiresAt])
  @@index([email])
  @@map("admin_invitations")
}

model AdminAccessRequest {
  id                  String    @id @default(uuid())
  requestingUserId    String
  permissionId        String?
  permissionKey       String
  businessReason      String
  requestedDuration   String?
  status              String    @default("pending") // pending | approved | rejected | cancelled
  reviewerUserId      String?
  decisionNotes       String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requestingUser User             @relation("AdminAccessRequestSubmitter", fields: [requestingUserId], references: [id], onDelete: Cascade)
  reviewer       User?            @relation("AdminAccessRequestReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  permission     AdminPermission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requestingUserId, createdAt])
  @@map("admin_access_requests")
}

model AdminAccessAuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  targetUserId String?
  action       String
  summary      String?
  previousValue Json?
  newValue     Json?
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor  User? @relation("AdminAccessAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AdminAccessAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("admin_access_audit_log")
}

// ===========================================================================
// Vendor Directory V1
// ===========================================================================

/// Canonical supplier identity. Distinct from marketplace Material and PI PriceMerchant.
model VendorProfile {
  id String @id @default(uuid())

  /// Null until claimed or self-signup completes account binding.
  userId String? @unique

  slug        String  @unique
  tradingName String
  legalName   String?
  description String? @db.Text
  logoUrl     String?

  yearEstablished Int?
  /// retailer | wholesaler | distributor | manufacturer | importer | fabricator | authorised_dealer | installer_supplier | rental_supplier
  businessTypes   String[] @default([])

  listingStatus      VendorListingStatus      @default(draft)
  verificationStatus VendorVerificationStatus @default(unverified)
  claimStatus        VendorClaimStatus        @default(unclaimed)

  /// Deterministic 0–100 completeness. Never treated as trust/verification.
  profileCompleteness Int @default(0)

  applicationReference String? @unique
  acquisitionSource    VendorAcquisitionSource @default(admin_manual)
  acquisitionNote      String?

  /// Public contact channels (only show when corresponding show* flag is true).
  publicPhone              String?
  publicWhatsApp           String?
  publicEmail              String?
  showPublicPhone          Boolean @default(true)
  showPublicWhatsApp       Boolean @default(true)
  showPublicEmail          Boolean @default(false)
  websiteUrl               String?
  /// Optional social map, e.g. { "instagram": "...", "facebook": "..." }
  socialLinks              Json?
  preferredContactMethod   VendorPreferredContactMethod?

  salesContactName       String?
  procurementContactName String?
  quotationEmail         String?
  businessHours          String?
  afterHoursAvailable    Boolean @default(false)

  /// Capability flags (vendor-level defaults; offerings may refine).
  acceptsSmallOrders       Boolean @default(true)
  acceptsBulkOrders        Boolean @default(true)
  acceptsProjectQuotations Boolean @default(true)
  canSupplyBoqQuotations   Boolean @default(false)
  canSourceUnstocked       Boolean @default(false)
  deliveryFleetAvailable   Boolean @default(false)
  thirdPartyDelivery       Boolean @default(false)
  pickupAvailable          Boolean @default(true)
  interstateDelivery       Boolean @default(false)
  installationAvailable    Boolean @default(false)
  afterSalesSupport        Boolean @default(false)
  warrantyHandling         Boolean @default(false)
  nationwideDelivery       Boolean @default(false)

  /// Payment / quote defaults (vendor claims, not market estimates).
  paymentMethodsAccepted   String[] @default([])
  depositRequired          Boolean?
  creditTermsNotes         String?
  priceListAvailable       Boolean  @default(false)
  priceListUrl             String?
  priceListUpdatedAt       DateTime?
  typicalQuoteResponseHours Int?
  pricesNegotiable         Boolean  @default(true)

  country              String  @default("NG")
  /// Prefer Price Checker location keys where possible (e.g. ng-lagos).
  stateKey             String?
  stateLabel           String?
  cityKey              String?
  cityLabel            String?
  lgaLabel             String?
  localAreaLabel       String?
  publicAddress        String?
  privateBusinessAddress String?
  addressVisibility    VendorAddressVisibility @default(public_city_state_only)
  latitude             Float?
  longitude            Float?

  /// Private verification identity (never exposed on public APIs).
  cacRegistrationStatus String? // registered | not_registered | unknown | not_applicable
  cacNumber             String?
  taxIdentificationNumber String?
  bankAccountName       String?

  /// Duplicate-detection helpers (normalized, not shown publicly).
  normalizedTradingName String?
  normalizedPhone       String?
  normalizedWhatsApp    String?
  normalizedEmail       String?
  websiteDomain         String?

  clarificationMessage String? @db.Text
  rejectionReason      String? @db.Text
  suspensionReason     String? @db.Text

  procurementRelationship VendorProcurementRelationship @default(never_contacted)
  previouslyUsedByBmh     Boolean @default(false)

  createdByAdminId String?
  approvedByAdminId String?
  verifiedByAdminId String?
  approvedAt       DateTime?
  verifiedAt       DateTime?
  submittedAt      DateTime?
  lastReviewedAt   DateTime?
  listedAt         DateTime?
  suspendedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User? @relation("UserVendorProfile", fields: [userId], references: [id], onDelete: SetNull)
  createdByAdmin User? @relation("VendorProfileCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  approvedByAdmin User? @relation("VendorProfileApprovedByAdmin", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  verifiedByAdmin User? @relation("VendorProfileVerifiedByAdmin", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  representatives   VendorRepresentative[]
  offerings         VendorOffering[]
  serviceAreas      VendorServiceArea[]
  documents         VendorDocument[]
  verificationChecks VendorVerificationCheck[]
  adminNotes        VendorAdminNote[]
  activities        VendorActivity[]
  claimInvites      VendorClaimInvite[]
  quoteRequests     VendorQuoteRequest[]
  changeRequests    VendorProfileChangeRequest[]

  @@index([listingStatus, verificationStatus])
  @@index([listingStatus, stateKey])
  @@index([claimStatus])
  @@index([acquisitionSource])
  @@index([procurementRelationship])
  @@index([normalizedPhone])
  @@index([normalizedWhatsApp])
  @@index([normalizedEmail])
  @@index([cacNumber])
  @@index([websiteDomain])
  @@index([submittedAt])
  @@index([createdAt])
  @@map("vendor_profiles")
}

model VendorRepresentative {
  id              String   @id @default(uuid())
  vendorProfileId String
  name            String
  role            String?
  phone           String?
  email           String?
  showPublicly    Boolean  @default(false)
  isPrimary       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId, isPrimary])
  @@map("vendor_representatives")
}

/// What the vendor sells — references Price Checker family keys when possible.
model VendorOffering {
  id              String @id @default(uuid())
  vendorProfileId String

  /// PriceProductFamily.key (e.g. cement, reinforcement-steel). Null when custom/other.
  familyKey           String?
  /// PriceCategory.code (structural, envelope, finishes, mep, energy, security).
  categoryCode        String?
  customCategoryLabel String?
  productTypes        String[] @default([])
  brands              String[] @default([])

  sellsRetail    Boolean @default(true)
  sellsWholesale Boolean @default(false)
  normalUnit     String?
  minimumOrderQuantity Float?
  minimumOrderUnit     String?
  stockedNormally Boolean @default(true)
  specialOrder    Boolean @default(false)

  deliveryAvailable     Boolean @default(false)
  installationAvailable Boolean @default(false)
  acceptsQuotations     Boolean @default(true)

  /// Pricing-policy fields for this offering (vendor claims only).
  quantityBreakNotes   String?
  pricesNegotiable     Boolean @default(true)
  deliveryIncluded     Boolean?
  deliveryPricingMethod String? // flat | per_km | per_trip | quote | unknown
  installationIncluded Boolean?
  vatStatus            String? // included | excluded | unknown
  priceValidityNotes   String?
  /// Optional illustrative price — NEVER feeds Price Checker estimates.
  examplePriceAmount   Decimal? @db.Decimal(14, 2)
  examplePriceCurrency String   @default("NGN") @db.Char(3)
  examplePriceUnit     String?
  examplePriceNotes    String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId])
  @@index([familyKey])
  @@index([categoryCode])
  @@map("vendor_offerings")
}

model VendorServiceArea {
  id              String  @id @default(uuid())
  vendorProfileId String
  /// Price Checker location key when known (ng-lagos, ng-ogun-mowe-ibafo, …).
  locationKey     String?
  stateKey        String?
  stateLabel      String?
  cityKey         String?
  cityLabel       String?
  /// delivery | service | both
  coverageType    String  @default("delivery")
  notes           String?
  createdAt       DateTime @default(now())

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId])
  @@index([stateKey])
  @@index([locationKey])
  @@map("vendor_service_areas")
}

/// Private verification / evidence documents (S3 refs). Never public.
model VendorDocument {
  id              String                     @id @default(uuid())
  vendorProfileId String
  documentType    VendorDocumentType
  label           String?
  /// S3 object key or private file ref — not a long-lived public URL.
  fileRef         String
  mimeType        String?
  fileSizeBytes   Int?
  reviewStatus    VendorDocumentReviewStatus @default(pending)
  rejectionReason String?
  expiresAt       DateTime?
  reviewedByAdminId String?
  reviewedAt      DateTime?
  uploadedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("VendorDocumentReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([vendorProfileId, documentType])
  @@index([reviewStatus])
  @@map("vendor_documents")
}

model VendorVerificationCheck {
  id              String                         @id @default(uuid())
  vendorProfileId String
  checkKey        VendorVerificationCheckKey
  status          VendorVerificationCheckStatus  @default(not_started)
  evidenceDocumentId String?
  notes           String?                        @db.Text
  failureReason   String?
  reviewedByAdminId String?
  reviewedAt      DateTime?
  expiresAt       DateTime?
  reverifyAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("VendorVerificationCheckReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@unique([vendorProfileId, checkKey])
  @@index([status])
  @@map("vendor_verification_checks")
}

model VendorAdminNote {
  id              String   @id @default(uuid())
  vendorProfileId String
  authorAdminId   String?
  body            String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  author        User?         @relation("VendorAdminNoteAuthor", fields: [authorAdminId], references: [id], onDelete: SetNull)

  @@index([vendorProfileId, createdAt])
  @@map("vendor_admin_notes")
}

model VendorActivity {
  id              String             @id @default(uuid())
  vendorProfileId String
  type            VendorActivityType
  summary         String?
  note            String?            @db.Text
  projectId       String?
  actorAdminId    String?
  metadata        Json?
  createdAt       DateTime           @default(now())

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor         User?         @relation("VendorActivityActor", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([vendorProfileId, createdAt])
  @@index([type, createdAt])
  @@index([projectId])
  @@map("vendor_activities")
}

model VendorClaimInvite {
  id               String    @id @default(uuid())
  vendorProfileId  String
  tokenHash        String    @unique
  email            String?
  phone            String?
  invitedByAdminId String?
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  invitedBy     User?         @relation("VendorClaimInviteCreator", fields: [invitedByAdminId], references: [id], onDelete: SetNull)

  @@index([vendorProfileId, expiresAt])
  @@index([email])
  @@map("vendor_claim_invites")
}

model VendorQuoteRequest {
  id               String                   @id @default(uuid())
  vendorProfileId  String
  product          String
  specification    String?
  quantity         String?
  deliveryLocation String?
  buyerName        String
  buyerEmail       String?
  buyerPhone       String?
  projectId        String?
  note             String?                  @db.Text
  status           VendorQuoteRequestStatus @default(new)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId, createdAt])
  @@index([status, createdAt])
  @@map("vendor_quote_requests")
}

/// Sensitive field-group edits that require admin review before going public.
model VendorProfileChangeRequest {
  id                String                     @id @default(uuid())
  vendorProfileId   String
  requestedByUserId String?
  /// identity | registration | representative | location | documents | other
  fieldGroup        String
  proposedPayload   Json
  currentPayload    Json?
  status            VendorChangeRequestStatus  @default(pending)
  reviewedByAdminId String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  requestedBy   User?         @relation("VendorChangeRequestRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy    User?         @relation("VendorChangeRequestReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([vendorProfileId, status])
  @@index([status, createdAt])
  @@map("vendor_profile_change_requests")
}
