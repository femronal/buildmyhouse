// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  homebuilding
  renovation
  interior_design
}

enum ProjectReviewStatus {
  pending_admin_review
  changes_requested
  approved
}

enum PaymentConfirmationStatus {
  not_declared
  declared
  confirmed
  rejected
}

enum ProjectRiskLevel {
  low
  medium
  high
}

enum StageChangeRequestStatus {
  pending
  approved
  rejected
}

enum ArticleAudience {
  homeowner
  gc
}

enum ServicePageRegion {
  lagos
  nigeria
}

// ---------------------------------------------------------------------------
// Vendor Directory V1 (Phase B)
// Public discovery + verification + supplier intelligence. Distinct from
// marketplace Material listings and Price Checker PriceMerchant sources.
// Locked decisions: listed ≠ verified; taxonomy via familyKey; Material.vendorId
// remains User; internal_only supported; claim invites for admin-created rows.
// ---------------------------------------------------------------------------

enum VendorListingStatus {
  draft
  submitted
  under_review
  clarification_required
  listed
  rejected
  suspended
  internal_only
}

enum VendorVerificationStatus {
  unverified
  partial
  verified
  expired
  revoked
}

enum VendorClaimStatus {
  unclaimed
  invite_sent
  claim_pending_admin
  claimed
}

enum VendorAcquisitionSource {
  vendor_self_signup
  admin_manual
  whatsapp
  project_supplier
  contractor_referral
  customer_referral
  field_team
  imported
  other
}

enum VendorProcurementRelationship {
  never_contacted
  contacted
  quoted
  purchased_from
  preferred
  do_not_use
}

enum VendorDocumentType {
  cac_certificate
  government_id
  proof_of_address
  storefront_photo
  warehouse_photo
  price_list
  tax_id
  bank_account_proof
  logo
  other
}

enum VendorDocumentReviewStatus {
  pending
  approved
  rejected
  expired
}

/// Checklist keys shown publicly only when status = passed (or not_applicable).
enum VendorVerificationCheckKey {
  business_identity
  business_registration
  representative_identity
  phone
  location_evidence
  product_categories
  supporting_evidence
}

enum VendorVerificationCheckStatus {
  not_started
  pending
  passed
  failed
  not_applicable
  expired
}

enum VendorActivityType {
  contacted
  quotation_requested
  quotation_received
  purchase_completed
  verification_call
  profile_correction
  clarification_requested
  clarification_received
  complaint
  suspension
  restoration
  note
  invitation_sent
  claim_accepted
  listing_approved
  verification_completed
  other
}

enum VendorChangeRequestStatus {
  pending
  approved
  rejected
  applied
  withdrawn
}

enum VendorPreferredContactMethod {
  phone
  whatsapp
  email
}

enum VendorQuoteRequestStatus {
  new
  notified
  closed
  spam
}

enum VendorAddressVisibility {
  public_city_state_only
  public_full_address
  private
}

model User {
  id                           String    @id @default(uuid())
  email                        String    @unique
  password                     String // Hashed password
  phone                        String?
  address                      String?
  city                         String?
  state                        String?
  country                      String?
  pictureUrl                   String?
  fullName                     String
  role                         String // 'homeowner' | 'general_contractor' | 'subcontractor' | 'vendor' | 'admin'
  verified                     Boolean   @default(false)
  homeownerTermsAcceptedAt     DateTime?
  gcTermsAcceptedAt            DateTime?
  profileSetupCompleted        Boolean   @default(false)
  managedParticipant           Boolean   @default(false)
  accessClaimedAt              DateTime?
  adminDashboardAccess         Boolean   @default(false)
  /// Bumped on suspend/revoke/session revoke so existing JWTs stop working.
  adminAccessVersion           Int       @default(0)
  forcePasswordReset           Boolean   @default(false)
  lastLoginAt                  DateTime?
  lastPasswordChangeAt         DateTime?
  failedLoginCount             Int       @default(0)
  lastFailedLoginAt            DateTime?
  stripeCustomerId             String?   @unique
  /// Stage 8 — PI sub-permissions. Empty array = all PI permissions (backward compatible for admins).
  priceIntelligencePermissions String[]  @default([])
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  // Relations
  homeownerProjects            Project[]               @relation("HomeownerProjects")
  contractorProjects           Project[]               @relation("ContractorProjects")
  sentMessages                 Message[]               @relation("SentMessages")
  receivedConversations        Conversation[]          @relation("Participants")
  vendorMaterials              Material[]              @relation("VendorMaterials")
  vendorProfile                VendorProfile?          @relation("UserVendorProfile")
  vendorProfilesCreated        VendorProfile[]         @relation("VendorProfileCreatedByAdmin")
  vendorProfilesApproved       VendorProfile[]         @relation("VendorProfileApprovedByAdmin")
  vendorProfilesVerified       VendorProfile[]         @relation("VendorProfileVerifiedByAdmin")
  vendorDocumentsReviewed      VendorDocument[]        @relation("VendorDocumentReviewer")
  vendorVerificationChecks     VendorVerificationCheck[] @relation("VendorVerificationCheckReviewer")
  vendorAdminNotesAuthored     VendorAdminNote[]       @relation("VendorAdminNoteAuthor")
  vendorActivitiesAuthored     VendorActivity[]        @relation("VendorActivityActor")
  vendorClaimInvitesCreated    VendorClaimInvite[]     @relation("VendorClaimInviteCreator")
  vendorChangeRequests         VendorProfileChangeRequest[] @relation("VendorChangeRequestRequester")
  vendorChangeRequestsReviewed VendorProfileChangeRequest[] @relation("VendorChangeRequestReviewer")
  contractorProfile            Contractor?             @relation("UserContractor")
  orders                       Order[]                 @relation("UserOrders")
  reviews                      Review[]                @relation("UserReviews")
  paymentMethods               PaymentMethod[]
  createdDesigns               Design[]                @relation("DesignCreatedBy")
  reviewedDesigns              Design[]                @relation("DesignReviewedByAdmin")
  contractorProjectRequests    ProjectRequest[]        @relation("ProjectRequestContractor")
  sentProjectRequests          ProjectRequest[]        @relation("ProjectRequestSender")
  houseViewingInterests        HouseViewingInterest[]  @relation("HomeownerViewingInterests")
  landViewingInterests         LandViewingInterest[]   @relation("HomeownerLandViewingInterests")
  rentalViewingInterests       RentalViewingInterest[] @relation("HomeownerRentalViewingInterests")
  homeownerDisputes            ProjectStageDispute[]   @relation("HomeownerDisputes")
  gcDisputes                   ProjectStageDispute[]   @relation("GeneralContractorDisputes")
  pushTokens                   PushToken[]
  notifications                Notification[]
  passwordResetTokens          PasswordResetToken[]
  projectAccessLinks           ProjectAccessLink[]     @relation("ProjectAccessParticipant")
  claimedAccessLinks           ProjectAccessLink[]     @relation("ProjectAccessClaimed")
  stageChangeRequestsSubmitted StageChangeRequest[]    @relation("StageChangeRequestedBy")
  stageChangeRequestsReviewed  StageChangeRequest[]    @relation("StageChangeReviewedBy")

  // Price intelligence (Stage 3)
  priceQueries           PriceQuery[]                 @relation("PriceQueries")
  priceResearchRequests  PriceResearchRequest[]       @relation("PriceResearchRequests")
  priceReports           PriceReport[]                @relation("PriceReports")
  priceCreditEvents      PriceCreditLedger[]          @relation("PriceCreditEvents")
  priceEvidenceUploads   PriceEvidenceDocument[]      @relation("PriceEvidenceUploader")
  priceCustomRequests    PriceCustomProductRequest[]  @relation("PriceCustomRequests")
  priceTaxonomyApprovals PriceTaxonomyChangeRequest[] @relation("PriceTaxonomyApprovals")
  priceReviewApprovals   PriceProfessionalReview[]    @relation("PriceReviewApprovals")

  // Price intelligence ops (Stage 8)
  priceReviewCasesAssigned         PriceReviewCase[]             @relation("PriceReviewCaseAssignee")
  priceReviewCaseEvents            PriceReviewCaseEvent[]        @relation("PriceReviewCaseEventActor")
  priceObservationCorrections      PriceObservationCorrection[]  @relation("PriceObservationCorrectionCreator")
  priceManualEntriesCreated        ManualPriceEntry[]            @relation("ManualPriceEntryCreator")
  priceManualEntriesReviewed       ManualPriceEntry[]            @relation("ManualPriceEntryReviewer")
  priceMerchantSubmissions         MerchantPriceSubmission[]     @relation("MerchantSubmissionCreator")
  priceMerchantItemReviews         MerchantPriceSubmissionItem[] @relation("MerchantItemReviewer")
  priceSourcesDisabled             PriceSource[]                 @relation("PriceSourceDisabledBy")
  priceReportRevisionsCreated      PriceReportRevision[]         @relation("PriceReportRevisionCreator")
  priceIntelligenceAuditEntries    PriceIntelligenceAuditLog[]   @relation("PriceIntelligenceAuditActor")
  priceIntelligenceReviewerProfile PriceIntelligenceReviewer?    @relation("PriceIntelligenceReviewerUser")

  // People & HR
  staffProfile                StaffProfile?         @relation("StaffProfileUser")
  managedStaff                StaffProfile[]        @relation("StaffManager")
  headedDepartments           Department[]          @relation("DepartmentHead")
  hrDocumentsUploaded         HrDocument[]          @relation("HrDocumentUploader")
  hrCommunicationsSent        HrCommunication[]     @relation("HrCommunicationSender")
  hrPoliciesCreated           HrPolicy[]            @relation("HrPolicyCreator")
  hrPoliciesUpdated           HrPolicy[]            @relation("HrPolicyUpdater")
  hrAuditEntries              HrAuditLog[]          @relation("HrAuditActor")
  onboardingTasksCompleted    OnboardingTask[]      @relation("OnboardingTaskCompleter")
  staffRoleAssignmentsGranted StaffRoleAssignment[] @relation("StaffRoleAssignmentGranter")
  hiringManagerCandidates     Candidate[]           @relation("CandidateHiringManager")

  // Admin Access Control
  adminAccessProfile              AdminAccessProfile?           @relation("AdminAccessProfileUser")
  adminAccessProfilesCreated      AdminAccessProfile[]          @relation("AdminAccessProfileCreator")
  adminAccessProfilesSponsored    AdminAccessProfile[]          @relation("AdminAccessProfileSponsor")
  adminUserRolesGranted           AdminUserRoleAssignment[]     @relation("AdminUserRoleGranter")
  adminPermissionOverridesGranted AdminPermissionOverride[]     @relation("AdminPermissionOverrideGranter")
  adminInvitationsCreated         AdminInvitation[]             @relation("AdminInvitationCreator")
  adminAccessRequestsSubmitted    AdminAccessRequest[]          @relation("AdminAccessRequestSubmitter")
  adminAccessRequestsReviewed     AdminAccessRequest[]          @relation("AdminAccessRequestReviewer")
  adminAccessAuditActorEntries    AdminAccessAuditLog[]         @relation("AdminAccessAuditActor")
  adminAccessAuditTargetEntries   AdminAccessAuditLog[]         @relation("AdminAccessAuditTarget")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String
  app        String
  deviceId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, app])
  @@map("push_tokens")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model CmsArticle {
  id                  String          @id @default(uuid())
  slug                String          @unique
  title               String
  description         String
  excerpt             String
  coverImageUrl       String
  coverImageAlt       String
  readingMinutes      Int             @default(5)
  tags                String[]        @default([])
  authorName          String          @default("BuildMyHouse Editorial")
  audience            ArticleAudience @default(homeowner)
  canonicalPath       String
  content             Json
  faqs                Json
  internalLinks       Json
  resourceSectionKeys String[]        @default([])
  articlePillar       String?
  isPublished         Boolean         @default(false)
  publishedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([isPublished, publishedAt, updatedAt])
  @@map("cms_articles")
}

model CmsResourceSection {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  hint      String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_resource_sections")
}

model CmsServicePage {
  id            String            @id @default(uuid())
  slug          String
  region        ServicePageRegion
  templateKind  String
  metaTitle     String
  summary       String
  canonicalPath String            @unique
  payload       Json
  isPublished   Boolean           @default(false)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([region, slug])
  @@index([isPublished, publishedAt, updatedAt])
  @@map("cms_service_pages")
}

model Project {
  id                        String                    @id @default(uuid())
  name                      String
  address                   String
  street                    String?
  city                      String?
  state                     String?
  zipCode                   String?
  country                   String?
  latitude                  Float?
  longitude                 Float?
  homeownerId               String
  generalContractorId       String?
  status                    String                    @default("draft") // 'draft' | 'active' | 'paused' | 'completed' | 'cancelled'
  riskLevel                 ProjectRiskLevel          @default(low)
  projectType               ProjectType?              @default(homebuilding)
  reviewStatus              ProjectReviewStatus?
  externalPaymentLink       String?
  paymentDeclaredAt         DateTime?
  paymentConfirmedAt        DateTime?
  paymentConfirmationStatus PaymentConfirmationStatus @default(not_declared)
  budget                    Float
  spent                     Float                     @default(0)
  progress                  Int                       @default(0)
  currentStage              String?
  startDate                 DateTime?
  dueDate                   DateTime?
  aiAnalysis                Json?
  aiProcessedAt             DateTime?
  planFileName              String?
  planPdfUrl                String?
  archivedAt                DateTime?
  managedByAdmin            Boolean                   @default(false)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  // Relations
  homeowner           User                  @relation("HomeownerProjects", fields: [homeownerId], references: [id])
  generalContractor   User?                 @relation("ContractorProjects", fields: [generalContractorId], references: [id])
  stages              Stage[]
  payments            Payment[]
  projectRequests     ProjectRequest[]
  orders              Order[]               @relation("ProjectOrders")
  disputes            ProjectStageDispute[]
  stageChangeRequests StageChangeRequest[]
  reviews             Review[]
  accessLinks         ProjectAccessLink[]
  vendorActivities    VendorActivity[]

  @@map("projects")
}

model Stage {
  id                String    @id @default(uuid())
  projectId         String
  name              String
  status            String    @default("not_started") // 'not_started' | 'in_progress' | 'completed' | 'blocked'
  order             Int
  estimatedCost     Float
  actualCost        Float?
  estimatedDuration String
  startDate         DateTime?
  completionDate    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments        Payment[]
  projectRequests ProjectRequest[]
  teamMembers     StageTeamMember[]
  materials       StageMaterial[]
  media           StageMedia[]
  documents       StageDocument[]
  disputes        ProjectStageDispute[]
  changeRequests  StageChangeRequest[]

  @@map("stages")
}

model StageChangeRequest {
  id                     String                   @id @default(uuid())
  projectId              String
  stageId                String
  requestedById          String
  reviewedById           String?
  status                 StageChangeRequestStatus @default(pending)
  requestTypes           String[]                 @default([])
  additionalAmount       Float?
  additionalDurationDays Int?
  requestedSiteChange    Boolean                  @default(false)
  siteChangeDetails      String?
  reason                 String
  evidence               Json?
  adminReviewNote        String?
  reviewedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("StageChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?   @relation("StageChangeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([projectId, stageId, createdAt])
  @@index([status, createdAt])
  @@map("stage_change_requests")
}

model ProjectStageDispute {
  id                  String    @id @default(uuid())
  projectId           String
  stageId             String
  homeownerId         String
  generalContractorId String?
  status              String    @default("open") // 'open' | 'in_review' | 'resolved'
  reasons             String[]  @default([])
  otherReason         String?
  resolutionNotes     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  resolvedAt          DateTime?
  inReviewAt          DateTime?

  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage             Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  homeowner         User    @relation("HomeownerDisputes", fields: [homeownerId], references: [id], onDelete: Cascade)
  generalContractor User?   @relation("GeneralContractorDisputes", fields: [generalContractorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([projectId, stageId, createdAt])
  @@map("project_stage_disputes")
}

model Payment {
  id                  String   @id @default(uuid())
  projectId           String?
  stageId             String?
  homeownerId         String? // Set at creation; preserved when project deleted for orphan queries
  amount              Float
  status              String   @default("pending") // 'pending' | 'processing' | 'completed' | 'failed' | 'refunded'
  method              String
  transactionId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  // Snapshot when paid (preserved when project deleted)
  snapshotProjectName String?
  snapshotStageName   String?

  // Relations
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  stage   Stage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model Conversation {
  id        String   @id @default(uuid())
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  participants User[]    @relation("Participants")
  messages     Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           String   @default("text") // 'text' | 'image' | 'file'
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

model Material {
  id          String   @id @default(uuid())
  name        String
  category    String
  brand       String
  description String?
  price       Float
  unit        String
  rating      Float    @default(0)
  reviews     Int      @default(0)
  verified    Boolean  @default(false)
  imageUrl    String?
  stock       Int      @default(0)
  vendorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vendor          User        @relation("VendorMaterials", fields: [vendorId], references: [id])
  orderItems      OrderItem[]
  materialReviews Review[]    @relation("MaterialReviews")

  @@map("materials")
}

model Contractor {
  id                              String   @id @default(uuid())
  userId                          String   @unique
  name                            String
  specialty                       String
  specialtyCategory               String?
  specialtyTags                   String[] @default([])
  description                     String?
  location                        String?
  experienceYears                 Int? // Years of experience (e.g. 15)
  rating                          Float    @default(5.0)
  reviews                         Int      @default(0)
  projects                        Int      @default(10)
  verified                        Boolean  @default(false)
  imageUrl                        String?
  hiringFee                       Float
  type                            String // 'general_contractor' | 'subcontractor'
  connectAccountId                String?
  professionalOnboardingCompleted Boolean  @default(false)
  professionalOnboardingSkipped   Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  // Relations
  user              User                      @relation("UserContractor", fields: [userId], references: [id], onDelete: Cascade)
  contractorReviews Review[]                  @relation("ContractorReviews")
  bankAccounts      BankAccount[]             @relation("ContractorBankAccounts")
  certifications    ContractorCertification[] @relation("ContractorCertifications")

  @@map("contractors")
}

model ContractorCertification {
  id           String   @id @default(uuid())
  contractorId String
  name         String // Display name (user-renamed)
  documentType String? // Optional required-verification document key
  fileUrl      String // Path to uploaded PDF/DOCX
  expiryYear   String? // Optional expiry year, e.g. "2026"
  createdAt    DateTime @default(now())

  contractor Contractor @relation("ContractorCertifications", fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_certifications")
}

model BankAccount {
  id               String   @id @default(uuid())
  contractorId     String
  bankName         String
  accountNumber    String
  accountOwnerName String
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  contractor Contractor @relation("ContractorBankAccounts", fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model Order {
  id              String   @id @default(uuid())
  userId          String
  projectId       String?
  type            String // 'material' | 'contractor'
  status          String   @default("pending") // 'pending' | 'confirmed' | 'shipped' | 'delivered' | 'cancelled'
  totalAmount     Float
  deliveryAddress String?
  deliveryStreet  String?
  deliveryCity    String?
  deliveryState   String?
  deliveryZipCode String?
  deliveryCountry String?
  deliveryLat     Float?
  deliveryLng     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user    User        @relation("UserOrders", fields: [userId], references: [id])
  project Project?    @relation("ProjectOrders", fields: [projectId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  materialId String?
  quantity   Int
  price      Float
  createdAt  DateTime @default(now())

  // Relations
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])

  @@map("order_items")
}

model Review {
  id           String   @id @default(uuid())
  userId       String
  materialId   String?
  contractorId String?
  projectId    String?
  rating       Int // 1-5
  comment      String?
  reasons      String[] @default([])
  otherReason  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user       User        @relation("UserReviews", fields: [userId], references: [id])
  material   Material?   @relation("MaterialReviews", fields: [materialId], references: [id], onDelete: Cascade)
  contractor Contractor? @relation("ContractorReviews", fields: [contractorId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, contractorId, projectId])
  @@index([projectId])
  @@map("reviews")
}

model PaymentMethod {
  id                    String   @id @default(uuid())
  userId                String
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int
  holderName            String?
  isBackup              Boolean  @default(false)
  stripePaymentMethodId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Design {
  id                  String      @id @default(uuid())
  name                String
  description         String?
  planType            ProjectType @default(homebuilding)
  projectTypeTag      String?
  projectTypeFilter   String?
  createdById         String
  bedrooms            Int
  bathrooms           Int
  squareFootage       Float
  squareMeters        Float?
  estimatedCost       Float
  rating              Float       @default(0)
  reviews             Int         @default(0)
  isActive            Boolean     @default(true)
  adminApprovalStatus String      @default("pending") // 'pending' | 'approved' | 'rejected'
  adminReviewReason   String?
  adminReviewedAt     DateTime?
  adminReviewedById   String?
  floors              Int?
  estimatedDuration   String?
  rooms               String[]    @default([])
  materials           String[]    @default([])
  features            String[]    @default([])
  constructionPhases  Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  createdBy       User          @relation("DesignCreatedBy", fields: [createdById], references: [id])
  adminReviewedBy User?         @relation("DesignReviewedByAdmin", fields: [adminReviewedById], references: [id])
  images          DesignImage[]

  @@map("designs")
}

model DesignImage {
  id        String   @id @default(uuid())
  designId  String
  url       String
  label     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@map("design_images")
}

model HouseForSale {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  opportunityCategory String?
  opportunityType     String?
  location            String
  price               Float
  bedrooms            Int
  bathrooms           Int
