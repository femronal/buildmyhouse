# API (include /api suffix to match app code)
EXPO_PUBLIC_API_URL=https://api.buildmyhouse.app/api

# Google Sign-In — use the **Web application** OAuth client ID from Google Cloud (same as backend GOOGLE_CLIENT_ID).
# Must be present at `expo export` / EAS build time (not only on the server).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: Web-only client ID if native builds use a different Google client
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Optional: override redirect URI (must match Google Console exactly, e.g. https://gc.buildmyhouse.app/)
# EXPO_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI=

# Trustindex review widget id (the part after "loader.js?" in the Trustindex embed code).
# One widget showing Google reviews only. Leave empty to hide the widget.
# EXPO_PUBLIC_TRUSTINDEX_WIDGET_ID
# Optional: separate widget styled for the contractor site. Falls back to EXPO_PUBLIC_TRUSTINDEX_WIDGET_ID.
# EXPO_PUBLIC_TRUSTINDEX_GC_WIDGET_ID
# Trustpilot Review Collector business unit id. Leave empty to use a plain review link.
# Set the same names as production build env (GitHub Actions secrets) before the widget can show live.
# EXPO_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID
